{
  "name": "serra",
  "version": "0.1.0-alpha.4",
  "private": true,
  "type": "module",
  "description": "A bridge from your team chat to the coding agents on your Mac: chat requests become T3 Code worktree threads. Slack today, more channels planned.",
  "license": "MIT",
  "author": "Isac",
  "scripts": {
    "start": "node src/index.ts",
    "check": "tsc -p . && tsc -p app && tsc -p app/renderer && node --run lint",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error && node scripts/lint-repo.ts && knip --no-config-hints",
    "lint:repo": "node scripts/lint-repo.ts",
    "knowledge": "node src/check-knowledge.ts",
    "evals:fetch": "git fetch --depth=1 origin pr-assets/evals && git archive FETCH_HEAD evals/results | tar -x",
    "setup": "node src/setup.ts",
    "doctor": "node src/doctor.ts",
    "onboard": "node src/onboard.ts",
    "bot": "node src/manage.ts",
    "test": "node --test --test-timeout=60000 tests/*.test.ts",
    "app:build": "node app/build.ts && vite build --config app/renderer/vite.config.ts",
    "app:dev": "pnpm app:build && node node_modules/electron/install.js && electron .",
    "app:renderer": "vite --config app/renderer/vite.config.ts",
    "app:package": "pnpm app:build && electron-builder --mac --publish never"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@slack/bolt": "^4.4.0",
    "electron-store": "12.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "knip": "6.46.1",
    "lucide-react": "1.66.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "tailwindcss": "4.3.4",
    "typescript": "^7.0.2",
    "vite": "8.3.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "electron-winstaller"
    ]
  },
  "main": "app/out/main/index.mjs"
}
