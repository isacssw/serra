{
  "id": "intake-010-identical-requests",
  "specs": [
    "INTAKE-010"
  ],
  "title": "two identical held requests, with a crash before the second's thread exists, get two threads: a replay never adopts another job's",
  "steps": [
    {
      "do": "pause"
    },
    {
      "do": "slack",
      "envelope": {
        "type": "event_callback",
        "team_id": "THOME",
        "api_app_id": "A1",
        "event_id": "Ev1",
        "event_time": 1700000100,
        "authorizations": [
          {
            "team_id": "THOME",
            "user_id": "UBOT",
            "is_bot": true
          }
        ],
        "event": {
          "type": "app_mention",
          "user": "USAM",
          "text": "<@UBOT> deploy staging",
          "ts": "1700000100.000100",
          "channel": "C1",
          "event_ts": "1700000100.000100",
          "team": "THOME"
        }
      }
    },
    {
      "do": "slack",
      "envelope": {
        "type": "event_callback",
        "team_id": "THOME",
        "api_app_id": "A1",
        "event_id": "Ev2",
        "event_time": 1700000100,
        "authorizations": [
          {
            "team_id": "THOME",
            "user_id": "UBOT",
            "is_bot": true
          }
        ],
        "event": {
          "type": "app_mention",
          "user": "USAM",
          "text": "<@UBOT> deploy staging",
          "ts": "1700000200.000100",
          "channel": "C2",
          "event_ts": "1700000200.000100",
          "team": "THOME"
        }
      },
      "expect": {
        "held": 2
      }
    },
    {
      "do": "resume"
    },
    {
      "_": "The first starts; the daemon dies while starting the second, before T3 made its thread.",
      "do": "t3.hangStart",
      "later": 2,
      "made": false
    },
    {
      "do": "advance",
      "ms": 15000,
      "expect": {
        "held": 1,
        "t3": {
          "started": 2
        },
        "state": {
          "C1:1700000100.000100": {
            "t3ThreadId": "t3-1"
          },
          "C2:1700000200.000100": "$none"
        }
      }
    },
    {
      "do": "crash",
      "expect": {
        "held": 0,
        "t3": {
          "started": 3
        },
        "state": {
          "C1:1700000100.000100": {
            "t3ThreadId": "t3-1"
          },
          "C2:1700000200.000100": {
            "t3ThreadId": "t3-2"
          }
        }
      }
    }
  ]
}
