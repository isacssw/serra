{
  "id": "reply-009-crash-before-post",
  "specs": [
    "REPLY-009"
  ],
  "title": "a reply that never reached Slack before a crash is posted once after the restart",
  "steps": [
    {
      "do": "slack",
      "envelope": {
        "type": "event_callback",
        "team_id": "THOME",
        "api_app_id": "A1",
        "event_id": "Ev1",
        "event_time": 1700000100,
        "authorizations": [
          {
            "team_id": "THOME",
            "user_id": "UBOT",
            "is_bot": true
          }
        ],
        "event": {
          "type": "app_mention",
          "user": "USAM",
          "text": "<@UBOT> what is the staging URL?",
          "ts": "1700000100.000100",
          "channel": "C1",
          "event_ts": "1700000100.000100",
          "team": "THOME"
        }
      }
    },
    {
      "do": "worker.reply",
      "text": "staging.acme.test"
    },
    {
      "do": "slack.hang",
      "method": "chat.postMessage"
    },
    {
      "do": "advance",
      "ms": 15000,
      "expect": {
        "state": {
          "C1:1700000100.000100": {
            "delivering": {
              "runId": "run-1"
            }
          }
        }
      }
    },
    {
      "do": "crash"
    },
    {
      "do": "advance",
      "ms": 15000,
      "expect": {
        "slack": [
          {
            "method": "chat.postMessage",
            "count": 2
          }
        ],
        "state": {
          "C1:1700000100.000100": {
            "lastPostedRunId": "run-1",
            "delivering": "$absent"
          }
        }
      }
    }
  ]
}
