{
  "id": "reply-009-recovered-reply-keeps-owner-ask",
  "specs": [
    "REPLY-009",
    "REPLY-004"
  ],
  "title": "a 'needs you' reply recovered after a crash still counts as the owner's open ask, so they aren't pinged for it again",
  "steps": [
    {
      "do": "slack",
      "envelope": {
        "type": "event_callback",
        "team_id": "THOME",
        "api_app_id": "A1",
        "event_id": "Ev1",
        "event_time": 1700000100,
        "authorizations": [
          {
            "team_id": "THOME",
            "user_id": "UBOT",
            "is_bot": true
          }
        ],
        "event": {
          "type": "app_mention",
          "user": "USAM",
          "text": "<@UBOT> deploy the fix",
          "ts": "1700000100.000100",
          "channel": "C1",
          "event_ts": "1700000100.000100",
          "team": "THOME"
        }
      }
    },
    {
      "do": "worker.reply",
      "text": "Ready to deploy.\n\nNeeds Alex: approve the production deploy."
    },
    {
      "do": "slack.hangAfter",
      "method": "chat.postMessage"
    },
    {
      "do": "advance",
      "ms": 15000
    },
    {
      "do": "crash"
    },
    {
      "do": "advance",
      "ms": 15000,
      "expect": {
        "slack": [
          {
            "method": "chat.postMessage",
            "count": 1
          }
        ],
        "state": {
          "C1:1700000100.000100": {
            "lastPostedRunId": "run-1",
            "ownerAskOpen": true,
            "ownerFollows": true
          }
        }
      }
    }
  ]
}
